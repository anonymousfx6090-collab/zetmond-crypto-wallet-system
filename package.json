{
  "name": "zetmond",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "description": "Zetmond marketing and production application workspace",
  "scripts": {
    "dev": "next dev marketing --hostname 127.0.0.1 --port 4173",
    "start": "next start marketing --hostname 127.0.0.1 --port 4173",
    "build": "next build marketing",
    "test": "playwright test",
    "dev:customer": "pnpm --filter @zetmond/customer dev",
    "dev:api": "pnpm --filter @zetmond/api dev",
    "build:auth": "pnpm --filter @zetmond/api build && pnpm --filter @zetmond/customer build",
    "test:auth": "pnpm --filter @zetmond/api test",
    "db:migrate": "pnpm --filter @zetmond/api db:migrate",
    "admin:provision": "pnpm --filter @zetmond/api admin:provision",
    "test:auth:browser": "playwright test --config playwright.auth.config.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0"
  }
}
