# Copy to .env and generate your own local key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NODE_ENV=development
# Hosted staging uses NODE_ENV=production and DEPLOYMENT_STAGE=staging.
# Production remains the default stage and requires approved launch policies.
DEPLOYMENT_STAGE=production
DATABASE_URL=postgresql://zetmond:local-development-only@127.0.0.1:5432/zetmond_auth
DATA_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
APP_ORIGIN=http://127.0.0.1:4200
# Local port; Render supplies PORT automatically. Production binds to 0.0.0.0.
PORT=4100
DELIVERY_MODE=development
TERMS_VERSION=development-draft
# Provisional development policy. Owner approval is required before production.
SECURITY_POLICY_APPROVED=false
SESSION_MINUTES=720
ADMIN_SESSION_MINUTES=60
CHALLENGE_MINUTES=10
CHALLENGE_ATTEMPTS=5
LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
RATE_WINDOW_SECONDS=900
RATE_LIMIT=30
RESEND_SECONDS=60
# Provider mode requires working email delivery; SMS is not used.
# Never use development mode in production.
# TERMS_URL=https://your-domain.example/terms
# PRIVACY_URL=https://your-domain.example/privacy
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
