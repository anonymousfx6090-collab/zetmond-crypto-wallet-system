# Account links default to https://zetmond.vercel.app without configuration.
# Optional override: copy to marketing/.env.local to use another customer origin.
# For a local customer app, use http://127.0.0.1:4200.
# For VS Code forwarded ports, use the customer port's browser-visible origin.
NEXT_PUBLIC_CUSTOMER_APP_ORIGIN=https://zetmond.vercel.app
